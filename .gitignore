# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments (scripts\build.bat creates venv\)
/venv/
/.venv/
/env/

# ── Build output (scripts\build.bat / PyInstaller) ───────────────────────────
/release/
/build/
/dist/
build_tmp/
*.spec

# ── Downloaded at runtime (can be several GB) ────────────────────────────────
# Voice model files (onnx\, and pytorch\ with the GPU pack)
/models/
# Optional GPU pack: PyTorch + CUDA
/engines/
# Interrupted downloads, resumed on the next try
*.part
# Hugging Face cache, if a tool creates one here
.cache/

# ── App output and user data (created on first run) ─────────────────────────
/audio_output/
/logs/
/user_data/
*.wav
*.mp3
*.log
*.tmp

# Legacy root locations from older versions (migrated to the folders above)
/settings.json
/settings.json.tmp
/draft.txt
/draft.txt.tmp
/pronunciations.json
/pronunciations.json.tmp

# ── Local experiments ───────────────────────────────────────────────────────
/trial/

# ── OS and editors ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
